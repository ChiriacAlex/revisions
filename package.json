{
  "name": "revisions",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content": "node scripts/copy-pyodide.mjs && tsx scripts/build-content.ts",
    "dev": "npm run content && next dev",
    "build": "npm run content && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:py": ".venv/bin/python -m pytest verify -q"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@uiw/react-codemirror": "^4.25.12",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.12",
    "katex": "^0.16.47",
    "next": "16.4.0",
    "pyodide": "^314.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
